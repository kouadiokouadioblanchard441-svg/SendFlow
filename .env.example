# Leave blank for the same-origin development API, or use an isolated staging URL.
# The Android Capacitor mode gets its production API URL from .env.capacitor.
VITE_API_URL=

# Cloudflare Turnstile site key: public, configured for the exact SendFlow
# production and preview hostnames. The Managed mode is selected in Cloudflare.
VITE_TURNSTILE_SITE_KEY=

# Server-only Cloudflare Turnstile secret. Configure through Replit Secrets;
# never place a real value in this file or expose it to the frontend.
TURNSTILE_SECRET_KEY=

# Non-secret key identifiers. Keep the lookup key ID stable across encryption
# key rotations so existing database lookup hashes remain usable.
CUSTOMER_PII_ENCRYPTION_KEY_ID=primary
CUSTOMER_PII_LOOKUP_KEY_ID=primary

# Optional compatibility alias; VITE_API_URL takes precedence.
# VITE_API_BASE_URL=

# Stripe is not used by the current SendFlow client; do not set a Stripe key.
