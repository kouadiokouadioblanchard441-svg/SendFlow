# Leave blank for the same-origin development API, or use an isolated staging URL.
# The Android Capacitor mode gets its production API URL from .env.capacitor.
VITE_API_URL=

# Optional compatibility alias; VITE_API_URL takes precedence.
# VITE_API_BASE_URL=

# Public Clerk key for the admin-only Clerk UI. Customer access remains server-owned OTP.
# Supply the real publishable key through Replit Secrets, not this example file.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_PUBLISHABLE_KEY

# Stripe is not used by the current SendFlow client; do not set a Stripe key.
