SENDFLOW_DATABASE_TARGET = "shared-external"
TRUST_PROXY_HOPS = "1"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 26095
externalPort = 3000
# Android SDK and JDK paths are resolved by android-sdk.nix and the Android build wrapper.
