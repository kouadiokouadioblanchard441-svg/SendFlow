modules = ["nodejs-24", "python-base-3.13", "postgresql-16", "java-graalvm22.3"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
# Pin Java 21 for the Android Gradle build; the Gradle Wrapper pins Gradle itself.
packages = ["jdk21"]

[userenv]

[userenv.shared]

[userenv.development]
DIDIT_ENVIRONMENT = "sandbox"
SENDFLOW_ADMIN_USER_IDS = "Il ne faut rien ajouter "
SENDFLOW_MUTATION_ADMIN_USER_IDS = "Il faut laisser d'abord "
SENDFLOW_DATABASE_TARGET = "shared-neon"
# Android SDK API 36 and Build Tools 35/36 are composed in this Repl's Nix store.
ANDROID_HOME = "/nix/store/4s1r6ykc3r6rpf5yflljp5xrwpqv2nj6-androidsdk/libexec/android-sdk"
ANDROID_SDK_ROOT = "/nix/store/4s1r6ykc3r6rpf5yflljp5xrwpqv2nj6-androidsdk/libexec/android-sdk"
JAVA_HOME = "/nix/store/k95pqfzyvrna93hc9a4cg5csl7l4fh0d-openjdk-21.0.7+6"
