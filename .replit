modules = ["web", "python-base-3.13", "nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
# Pin Java 21 for the Android Gradle build; the Gradle Wrapper pins Gradle itself.
packages = ["jdk21"]

[userenv]

[userenv.shared]
VITE_TURNSTILE_SITE_KEY = "0x4AAAAAAFwM4y2TRTrwsOyP"
SENDFLOW_DATABASE_TARGET = "shared-external"

[userenv.development]
TRUST_PROXY_HOPS = "1"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 26095
externalPort = 3000
# Android SDK and JDK paths are resolved by android-sdk.nix and the Android build wrapper.
