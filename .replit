modules = ["nodejs-20", "web", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
# Pin Java 21 for the Android Gradle build; the Gradle Wrapper pins Gradle itself.
packages = ["jdk21"]

[userenv]

[userenv.shared]

[userenv.development]
DIDIT_ENVIRONMENT = "sandbox"
SENDFLOW_ADMIN_USER_IDS = "Il ne faut rien ajouter "
SENDFLOW_MUTATION_ADMIN_USER_IDS = "Il faut laisser d'abord "
SENDFLOW_DATABASE_TARGET = "shared-neon"
TRUST_PROXY_HOPS = "1"
# Android SDK and JDK paths are resolved by android-sdk.nix and the Android build wrapper.
