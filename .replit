modules = ["web", "python-base-3.13", "nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
# Pin Java 21 for the Android Gradle build; the Gradle Wrapper pins Gradle itself.
packages = ["jdk21"]

[userenv]

[userenv.shared]
FEEXPAY_EXECUTION_HOST = "replit"
FEEXPAY_LIVE_ENABLED = "true"
FEEXPAY_MODE = "live"
