{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start:dev",
    "build": "node ./build.mjs",
    "start:dev": "node --enable-source-maps ./.dev-dist/index.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:otp": "node --experimental-strip-types --test src/lib/resend-email.test.mjs src/lib/email-otp-code.test.mjs",
    "test:turnstile": "node --experimental-strip-types --test src/lib/turnstile.test.mjs",
    "test:turnstile:isolated": "node tests/security/run-isolated-finance.mjs --turnstile-only",
    "test:log-safety": "node --experimental-strip-types --test src/lib/log-safety.test.mjs",
    "test:auth": "node --experimental-strip-types --test src/lib/customer-auth-crypto.test.mjs src/lib/sensitive-data-crypto.test.mjs src/lib/admin-pin-session.test.mjs src/lib/customer-auth-rate-limit-policy.test.mjs src/lib/customer-auth-rate-limit-buckets.test.mjs src/lib/customer-pin-session-policy.test.mjs src/lib/customer-password-policy.test.mjs src/lib/customer-recovery-policy.test.mjs src/lib/customer-biometric-origin.test.mjs",
    "test:identity-verification": "node --experimental-strip-types --test src/lib/identity-verification-policy.test.mjs src/lib/identity-verification-image.test.mjs src/lib/identity-verification-pdf.test.mjs",
    "test:security": "node --experimental-strip-types --test src/lib/account-limit-policy.test.mjs src/lib/admin-pin-session.test.mjs src/lib/api-request-security.test.mjs src/lib/provider-call-policy.test.mjs src/lib/origin-policy.test.mjs src/lib/trust-proxy-policy.test.mjs src/lib/shared-database-preview-guard.test.mjs src/lib/operator-pricing-seed-policy.test.mjs src/lib/customer-pin-session-policy.test.mjs src/lib/sql-injection-boundary.test.mjs",
    "test:developer-webhooks:isolated": "node --experimental-strip-types --test src/services/developer-webhook-worker.integration.test.mjs",
    "test:body-parser-security": "node --experimental-strip-types --test src/lib/body-parser-security.test.mjs",
    "test:routes:isolated": "node --experimental-strip-types --test src/lib/api-request-security.test.mjs src/lib/public-object-response-policy.test.mjs && node tests/security/run-isolated-finance.mjs --routes-security-only",
    "test:wallet-integrity": "node --test tests/security/test_concurrency_wallet_integrity.mjs",
    "test:finance:isolated": "node tests/security/run-isolated-finance.mjs",
    "test:admin-access:isolated": "node tests/security/run-isolated-admin-access.mjs",
    "test:sensitive-data-crypto": "node --experimental-strip-types --test src/lib/sensitive-data-crypto.test.mjs src/lib/developer-webhook-payload.test.mjs",
    "test:transfer-quote": "node --experimental-strip-types --test src/lib/transfer-quote-policy.test.mjs",
    "test:feexpay": "node --experimental-strip-types --test src/providers/feexpay/client.test.mjs",
    "test:feexpay-configuration": "node tests/security/run-isolated-finance.mjs --feexpay-configuration-only",
    "test:payment-structures": "node tests/security/run-isolated-finance.mjs --payment-structures-only",
    "test:payment-links:isolated": "node tests/security/run-isolated-finance.mjs --payment-links-only",
    "payments:schema-plan": "node --experimental-strip-types scripts/migrate-payment-structures.mjs",
    "payment-links:schema-plan": "node --experimental-strip-types scripts/migrate-customer-payment-links.mjs",
    "linkflow-payment:schema-plan": "node --experimental-strip-types scripts/migrate-linkflow-payment-attempts.mjs",
    "linkflow-variable-amount:schema-plan": "node --experimental-strip-types scripts/migrate-linkflow-variable-amount.mjs",
    "payment-links:soft-delete-migration": "node --experimental-strip-types scripts/migrate-customer-payment-link-soft-delete.mjs",
    "customer-biometric:schema-plan": "node --experimental-strip-types scripts/migrate-customer-biometric.mjs",
    "customer-biometric:rp-scope-plan": "node --experimental-strip-types scripts/migrate-customer-biometric-rp-scope.mjs",
    "developers:test-keys-migration": "node --experimental-strip-types scripts/migrate-developer-api-test-keys.mjs",
    "identity-verification:migration": "node --experimental-strip-types scripts/migrate-customer-identity-verification.mjs",
    "email-campaigns:schema-migration": "node --experimental-strip-types scripts/migrate-email-campaign-schema.mjs",
    "linkflow-pricing-migration": "node --experimental-strip-types scripts/migrate-linkflow-pricing-rates.mjs",
    "payments:test-access-plan": "node --experimental-strip-types scripts/migrate-payment-test-access.mjs",
    "payments:test-account-plan": "node --experimental-strip-types scripts/authorize-replit-payment-test-account.mjs",
    "feexpay:configuration-plan": "node --experimental-strip-types scripts/configure-feexpay.mjs",
    "pii:backfill": "node --experimental-strip-types scripts/backfill-sensitive-data.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "@swc/helpers": "0.5.23",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "pdfkit": "^0.20.2",
    "pg": "8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "svix": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.7",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
