{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "seed": "node ./seed.mjs",
    "seed-admin": "node ./seed-admin.mjs",
    "migrate-media": "node ./migrate-landing-media.mjs",
    "migrate-media:dry-run": "node ./migrate-landing-media.mjs --dry-run"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^0.31.10"
  }
}
